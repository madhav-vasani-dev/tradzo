# ── Tradzo backend configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

# --- Server ---
HOST=0.0.0.0
PORT=8080
# Comma-separated list of allowed CORS origins
# Production: your Vercel frontend URL
# Development: http://localhost:4200
CORS_ORIGINS=https://tradzo.vercel.app,http://localhost:4200

# Where the Angular app lives — the OAuth callback redirects the browser back here.
# Production: your Vercel frontend URL
FRONTEND_BASE_URL=https://tradzo.vercel.app

# --- Upstox (bring-your-own-key) ---
# Each user supplies their OWN Upstox app key/secret at connect time, so the
# CLIENT_ID/SECRET below are only an optional platform-wide fallback and can be
# left blank. The REDIRECT URI, however, is shared: every user must register
# EXACTLY this URI in their own Upstox app (developer.upstox.com).
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Production: use your Fly.io backend URL
UPSTOX_REDIRECT_URI=https://tradzo-backend.fly.dev/broker/upstox/callback

# --- Jainam (Symphony XTS Retail) ---
# Users bring their own XTS keys (Interactive + Market Data). Set the host for
# your Jainam XTS environment; jtrade.jainam.in:5000 is the Retail host.
JAINAM_XTS_BASE_URL=https://jtrade.jainam.in:5000
JAINAM_XTS_SOURCE=WebAPI

# --- Firebase Admin SDK ---
# Absolute path to the service-account JSON downloaded from
# Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- Token encryption ---
# 32-byte urlsafe base64 key used to encrypt broker tokens at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Scheduler ---
# Set to "false" to disable APScheduler (useful for pure API/local dev).
ENABLE_SCHEDULER=true
